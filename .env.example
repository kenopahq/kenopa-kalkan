# Meta Model API key. Kalkan reads META_API_KEY, then MODEL_API_KEY (Meta's own name).
# Leave unset to run the offline mock provider. Never commit a real key.
META_API_KEY=
# MODEL_API_KEY=

# auto: meta when a key is set, otherwise mock.
KALKAN_PROVIDER=auto

# auto: heuristic, unless KALKAN_SCREEN=prompt-guard and the weights load.
# prompt-guard downloads nothing by itself; you must already be logged in to
# Hugging Face and have accepted the Llama 4 Community License gate.
KALKAN_SCREEN=auto

# Standard (non-contributor) model IDs only. Contributor IDs are refused.
KALKAN_SPARK_MODEL=muse-spark-1.3
KALKAN_WONDER_MODEL=muse-wonder-1.0
KALKAN_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M

KALKAN_HOST=0.0.0.0
KALKAN_PORT=8080
